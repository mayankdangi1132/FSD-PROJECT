{
  "info": {
    "name": "Campus Connect API",
    "description": "Run 'Login' first. The test script saves the token into the {{token}} variable so the other requests work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@college.edu\",\n  \"password\": \"admin123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get logged in user",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Events (public)",
      "item": [
        {
          "name": "Get all events",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/events" }
        },
        {
          "name": "Upcoming events",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/events?when=upcoming" }
        },
        {
          "name": "Completed events",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/events?when=completed" }
        },
        {
          "name": "Search + filter",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/events?search=hack&category=Technical"
          }
        },
        {
          "name": "Events on a date",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/events?date=2026-11-20" }
        },
        {
          "name": "Get event by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/events/{{eventId}}" }
        },
        {
          "name": "Clubs list",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/organizers?role=club" }
        },
        {
          "name": "Departments list",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/organizers?role=department" }
        }
      ]
    },
    {
      "name": "Events (organizer / admin)",
      "item": [
        {
          "name": "My events",
          "request": { "method": "GET", "url": "{{baseUrl}}/events/mine" }
        },
        {
          "name": "Create event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) pm.collectionVariables.set('eventId', data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Quiz Night\",\n  \"description\": \"General quiz for all students\",\n  \"category\": \"Competition\",\n  \"startDate\": \"2026-12-10\",\n  \"endDate\": \"2026-12-10\",\n  \"startTime\": \"17:00\",\n  \"endTime\": \"19:00\",\n  \"venue\": \"Seminar Hall 2\",\n  \"eventType\": \"competitive\",\n  \"contactEmail\": \"admin@college.edu\"\n}"
            },
            "url": "{{baseUrl}}/events"
          }
        },
        {
          "name": "Update event",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"venue\": \"Main Auditorium\"\n}" },
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        },
        {
          "name": "Add / update winners",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"winners\": [\n    { \"position\": 1, \"name\": \"Ravi K\", \"usn\": \"1XX22CS001\", \"department\": \"CSE\", \"semester\": \"5\" },\n    { \"position\": 2, \"name\": \"Team Alpha\", \"teamName\": \"Alpha\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/events/{{eventId}}/winners"
          }
        },
        {
          "name": "Delete event",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/events/{{eventId}}" }
        },
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/upload"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "All events (any status)",
          "request": { "method": "GET", "url": "{{baseUrl}}/events/admin/all" }
        },
        {
          "name": "Approve / reject event",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\"\n}" },
            "url": "{{baseUrl}}/events/{{eventId}}/status"
          }
        },
        {
          "name": "List organizer accounts",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" }
        },
        {
          "name": "Create organizer account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) pm.collectionVariables.set('userId', data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Robotics Club\",\n  \"email\": \"robotics@college.edu\",\n  \"password\": \"robo123\",\n  \"role\": \"club\",\n  \"description\": \"Robots and drones\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Update / disable organizer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Delete organizer",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" }
        }
      ]
    },
    {
      "name": "Dashboards",
      "item": [
        { "name": "Admin stats", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/admin" } },
        { "name": "Organizer stats", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/organizer" } },
        {
          "name": "Student dashboard",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/dashboard/student" }
        }
      ]
    }
  ]
}
