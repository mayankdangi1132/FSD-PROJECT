# not using 5000 because macOS AirPlay already uses that port
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/campus_connect
JWT_SECRET=change_this_to_a_long_random_string

# frontend url (for CORS). leave empty to allow all while developing
CLIENT_URL=http://localhost:5173

# every account the admin creates must use this email domain (extra check, leave empty to allow any)
COLLEGE_EMAIL_DOMAIN=college.edu

# true = club/department events need admin approval before students can see them
REQUIRE_APPROVAL=true

# Cloudinary (optional). If these are empty, images are saved in backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# the ONLY admin account. used by "npm run create-admin" (and "npm run seed").
# only this email gets admin access. use a strong password (min 8 characters).
ADMIN_NAME=College Administration
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-this-password
